# LocalBench Studio environment overrides.
# Copy to .env and adjust. All values are optional; defaults are local and safe.

# Host/interface to bind. Default 127.0.0.1 (localhost only).
# WARNING: binding to 0.0.0.0 exposes the app on all interfaces. The app has
# NO multi-user authentication. Only do this on a trusted private network.
LOCALBENCH_HOST=127.0.0.1
LOCALBENCH_PORT=8765

# Override the local data directory. Defaults to an OS-appropriate location:
#   Windows: %LOCALAPPDATA%\LocalBenchStudio
#   Linux:   ~/.local/share/localbench-studio
# LOCALBENCH_DATA_DIR=

# Log level: DEBUG, INFO, WARNING, ERROR
LOCALBENCH_LOG_LEVEL=INFO

# Secret used to protect the local data directory. Auto-generated on first run
# and stored in the data directory if not provided here.
# LOCALBENCH_SECRET=

# Enable plaintext fallback for API keys when the OS keyring is unavailable.
# WARNING: this stores keys in SQLite. Off by default.
# LOCALBENCH_ALLOW_PLAINTEXT_KEY_FALLBACK=false
